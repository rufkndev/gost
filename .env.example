# Скопируйте в .env (cp .env.example .env) и заполните. Файл .env в git не попадает.
# Комментарии — только на отдельных строках: Docker Compose считает текст после значения его частью.
# Подробное описание каждой переменной — docs/GUIDE.md, раздел «Переменные окружения».

# --- Docker Compose ---
# чтобы `docker compose ...` из корня находил файл в docker/
COMPOSE_FILE=docker/docker-compose.yml

# --- Общее ---
# dev | test | prod; в prod запрещён DEBUG_TEXT_LOGS
ENVIRONMENT=prod
# подробность логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# писать текст документов в логи (только для отладки)
DEBUG_TEXT_LOGS=false
# адрес Sentry для ошибок; пусто — не используется
SENTRY_DSN=

# --- Telegram ---
# токен от @BotFather; пусто — бот не опрашивает Telegram
BOT_TOKEN=
# имя бота без @ — сюда возвращает пользователя после оплаты
BOT_USERNAME=
# Telegram id владельцев через запятую: /admin и уведомления
ADMIN_IDS=

# --- База данных и Redis (домен и HTTPS не нужны: бот работает через long polling) ---
# пользователь PostgreSQL (создаётся при первом запуске)
POSTGRES_USER=gost
# пароль PostgreSQL — обязательно сменить
POSTGRES_PASSWORD=change-me
# имя базы
POSTGRES_DB=gost
# только для запуска без Docker
DATABASE_URL=postgresql+asyncpg://gost:change-me@localhost:5432/gost
# только для запуска без Docker (в Docker задаётся сам)
REDIS_URL=redis://localhost:6379/0

# --- ЮKassa ---
# shopId магазина (сначала тестового)
YOOKASSA_SHOP_ID=
# секретный ключ магазина
YOOKASSA_SECRET_KEY=
# цена оформления одного документа, ₽
PRICE_RUB=300
# сколько живёт ссылка на оплату
PAYMENT_TTL_MINUTES=30
# отправлять чеки 54-ФЗ через ЮKassa (нужен email)
RECEIPTS_ENABLED=false
# код НДС в чеке (1 — без НДС); уточнить у бухгалтера
RECEIPT_VAT_CODE=1

# --- ИИ (OpenAI) ---
# уточнять неуверенные абзацы через ИИ
LLM_ENABLED=false
# ключ API OpenAI
OPENAI_API_KEY=
# основная модель ($0,10 / $0,50 за 1M токенов)
LLM_MODEL=gpt-6-luna
# повтор, если основная ответила невалидно
LLM_ESCALATION_MODEL=gpt-6-sol
# потолок расходов на ИИ для одного документа, $
LLM_MAX_COST_PER_DOC_USD=0.05
# сколько абзацев максимум отправлять в ИИ за документ
LLM_MAX_BLOCKS=60
# таймаут запроса к ИИ, с
LLM_TIMEOUT_S=60

# --- Классификация и вопросы ---
# уверенность, с которой решение правил принимается сразу
CLASSIFY_ACCEPT_THRESHOLD=0.90
# от этой уверенности до предыдущей — в ИИ; ниже — пользователю
CLASSIFY_LLM_THRESHOLD=0.60
# максимум уточняющих вопросов пользователю
MAX_USER_QUESTIONS=5
# сколько ждать ответа, потом берётся лучший вариант
QUESTION_TIMEOUT_MINUTES=30

# --- Бета ---
# бета-режим: оплата пропускается для бета-пользователей
BETA_MODE=false
# Telegram id бета-пользователей через запятую
BETA_USER_IDS=

# --- Файлы и лимиты ---
# папка для документов (в Docker — общий том)
STORAGE_DIR=/data/files
# шифровать файлы на диске
STORAGE_ENCRYPTION=false
# ключ шифрования: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_FERNET_KEY=
# максимальный размер файла (лимит Telegram для ботов — 20 МБ)
MAX_UPLOAD_MB=20
# защита от zip-бомбы: размер после распаковки
MAX_UNZIPPED_MB=200
# предельное время оформления одного документа
PROCESS_TIMEOUT_S=120
# документов в час на пользователя
RATE_LIMIT_DOCS_PER_HOUR=10
# сообщений в минуту на пользователя
RATE_LIMIT_MSGS_PER_MINUTE=30

# --- Сроки хранения файлов (те же сроки указаны в политике ПДн) ---
# неоплаченный анализ
RETENTION_UNPAID_HOURS=2
# исходник и результат после выдачи
RETENTION_PAID_HOURS=24
# по жалобе (с согласия) и при ошибке оформления
RETENTION_COMPLAINT_DAYS=14

# --- Реквизиты (подставляются в оферту, политику ПДн и правила) ---
# ФИО ИП: Таранов Артём Игоревич
IP_NAME=
# ИНН ИП
INN=
# ОГРНИП
OGRNIP=
# кем и когда зарегистрирован: «зарегистрирован Управлением ФНС по … 22.07.2025»
IP_REGISTRATION=
# email для претензий и запросов по ПДн
CONTACT_EMAIL=
# контакт поддержки (@username или ссылка); пусто — email
SUPPORT_CONTACT=
# версия документов; увеличьте — бот снова спросит согласие
TERMS_VERSION=1

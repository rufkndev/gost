# Образ worker: arq + LibreOffice headless + шрифты.
FROM python:3.12-slim-bookworm

ARG INSTALL_MSCOREFONTS=1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

# Liberation Serif метрически совместим с Times New Roman — запасной вариант,
# если загрузка ttf-mscorefonts-installer (он качает шрифты с sourceforge) не удалась.
RUN set -eux; \
    sed -i 's/^Components: main$/Components: main contrib/' /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libreoffice-writer-nogui fonts-liberation fontconfig ca-certificates; \
    if [ "$INSTALL_MSCOREFONTS" = "1" ]; then \
        echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" \
            | debconf-set-selections; \
        apt-get install -y --no-install-recommends ttf-mscorefonts-installer \
            || echo "WARNING: mscorefonts not installed, Liberation Serif will be used"; \
    fi; \
    fc-cache -f; \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /usr/local/bin/uv

WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY alembic.ini ./
COPY app ./app
COPY docs/legal ./docs/legal
RUN uv sync --frozen --no-dev

RUN useradd --uid 10001 --create-home app && mkdir -p /data/files && chown app /data/files
USER app
